<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="JIBNAM"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JIBNAM" >

        <!-- เปิดแอป → MainActivity เช็กข้อมูล: ผู้ใช้ใหม่ไป Screen_1 / มีข้อมูลแล้วไป Screen_2 -->
        <activity
            android:name=".CODE.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- ตัวรับปลุกเตือนดื่มน้ำ -->
        <receiver android:name=".CODE.Notification" android:exported="false" />
        <activity
            android:name=".SCREEN.Screen_2"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SCREEN.Screen_1" android:exported="false" />
        <activity android:name=".SCREEN.Screen_3" android:exported="false" />
        <activity android:name=".SCREEN.Screen_4" android:exported="false" />
        <activity android:name=".SCREEN.Screen_5" android:exported="false" />
        <activity android:name=".SCREEN.Screen_6" android:exported="false" />
    </application>

</manifest>